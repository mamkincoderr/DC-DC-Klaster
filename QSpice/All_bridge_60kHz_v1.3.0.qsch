  «text (20000,13060) 1 0 0 0x1000000 -1 -1 "ï»¿RGF12 GD2B_F GD2B_DRV 3"»
  «text (20000,13280) 1 0 0 0x1000000 -1 -1 "ï»¿* --- symmetry: leak resistor for the second secondary ---"»
  «text (20000,13500) 1 0 0 0x1000000 -1 -1 "ï»¿R6 SECWIND3 0 100Meg"»
  «text (20000,13720) 1 0 0 0x1000000 -1 -1 "ï»¿* --- R4 = DC resistance of the transfer choke L1 (not from EP, estimate) ---"»
  «text (20000,13940) 1 0 0 0x1000000 -1 -1 "ï»¿* --- TPS: three phase shifts locked to the voltage ratio ---"»
  «text (20000,14160) 1 0 0 0x1000000 -1 -1 "ï»¿.param NT=7.667 PHNOM=25 TPS=1 AMIN=18 AMAX=90 ALOAD=0.5"»
  «text (20000,14380) 1 0 0 0x1000000 -1 -1 "ï»¿BPHCMD PHCMD 0 V=if(time<9.7m,V(CTRL),V(PH13))"»
  «text (20000,14600) 1 0 0 0x1000000 -1 -1 "ï»¿RPHCMD PHCMD 0 1G"»
  «text (20000,14820) 1 0 0 0x1000000 -1 -1 "ï»¿BDR DRAW 0 V=NT*V(LVBUS)/max(V(HV),1)"»
  «text (20000,15040) 1 0 0 0x1000000 -1 -1 "ï»¿RDRAW DRAW DRATIO 10k"»
  «text (20000,15260) 1 0 0 0x1000000 -1 -1 "ï»¿CDR DRATIO 0 16n"»
  «text (20000,15480) 1 0 0 0x1000000 -1 -1 "ï»¿RDR DRATIO 0 1G"»
  «text (20000,15700) 1 0 0 0x1000000 -1 -1 "ï»¿BAF AFULL 0 V=2*acos(min(V(DRATIO),1/V(DRATIO)))*180/pi"»
  «text (20000,15920) 1 0 0 0x1000000 -1 -1 "ï»¿RAF AFULL 0 1G"»
  «text (20000,16140) 1 0 0 0x1000000 -1 -1 "ï»¿BAL ALPHA 0 V=TPS*min(AMAX,V(AFULL)*max(ALOAD,1-abs(V(PHCMD))/PHNOM))"»
  «text (20000,16360) 1 0 0 0x1000000 -1 -1 "ï»¿RAL ALPHA 0 1G"»
  «text (20000,16580) 1 0 0 0x1000000 -1 -1 "ï»¿BAG ALPHAG 0 V=if(V(ALPHA)<AMIN,0,V(ALPHA))"»
  «text (20000,16800) 1 0 0 0x1000000 -1 -1 "ï»¿RAG ALPHAG 0 1G"»
  «text (20000,17020) 1 0 0 0x1000000 -1 -1 "ï»¿BA1 ALPHA1 0 V=if(V(DRATIO)<1,V(ALPHAG),0)"»
  «text (20000,17240) 1 0 0 0x1000000 -1 -1 "ï»¿RA1 ALPHA1 0 1G"»
  «text (20000,17460) 1 0 0 0x1000000 -1 -1 "ï»¿BA2 ALPHA2 0 V=if(V(DRATIO)>1,V(ALPHAG),0)"»
  «text (20000,17680) 1 0 0 0x1000000 -1 -1 "ï»¿RA2 ALPHA2 0 1G"»
  «text (36000,8000) 1 0 0 0x1000000 -1 -1 "ï»¿BPHB PHASEB 0 V=180-V(ALPHA1)"»
  «text (36000,8220) 1 0 0 0x1000000 -1 -1 "ï»¿* --- segment 13: 360 V / 52 V, closed current loop -Inom..+Inom ---"»
  «text (36000,8440) 1 0 0 0x1000000 -1 -1 "ï»¿.ic V(INTG)=0"»
  «text (36000,8660) 1 0 0 0x1000000 -1 -1 "ï»¿VIREF IREF 0 PWL(0 -38.5 10.1m -38.5 13.7m 38.5 14m 38.5)"»
  «text (36000,8880) 1 0 0 0x1000000 -1 -1 "ï»¿BIM IM 0 V=I(V5)"»
  «text (36000,9100) 1 0 0 0x1000000 -1 -1 "ï»¿RIM IM IFB 1k"»
  «text (36000,9320) 1 0 0 0x1000000 -1 -1 "ï»¿CIFB IFB 0 33n"»
  «text (36000,9540) 1 0 0 0x1000000 -1 -1 "ï»¿BINT 0 INTG I=(time>9.75m)*4m*(V(IREF)-V(IFB))"»
  «text (36000,9760) 1 0 0 0x1000000 -1 -1 "ï»¿CINT INTG 0 1u"»
  «text (36000,9980) 1 0 0 0x1000000 -1 -1 "ï»¿RINT INTG 0 1G"»
  «text (36000,10200) 1 0 0 0x1000000 -1 -1 "ï»¿BPH13 PH13 0 V=max(-60,min(60,0.05*(V(IREF)-V(IFB))+V(INTG)))"»
  «text (36000,10420) 1 0 0 0x1000000 -1 -1 "ï»¿RPH13 PH13 0 1G"»
  «text (36000,10640) 1 0 0 0x1000000 -1 -1 "ï»¿* --- gate overlap detectors (cross-conduction) ---"»
  «text (36000,10860) 1 0 0 0x1000000 -1 -1 "ï»¿BXA XA 0 V=(V(GA1)-V(A)>3.5)*(V(GA2)>3.5)"»
  «text (36000,11080) 1 0 0 0x1000000 -1 -1 "ï»¿BXC XC 0 V=(V(GC1)-V(SECWIND)>1.75)*(V(GC2)>1.75)"»
  «text (36000,11300) 1 0 0 0x1000000 -1 -1 "ï»¿RXA XA 0 1G"»
  «text (36000,11520) 1 0 0 0x1000000 -1 -1 "ï»¿RXC XC 0 1G"»
  «text (36000,11740) 1 0 0 0x1000000 -1 -1 "ï»¿.meas tran s13_ir00 AVG V(IREF) FROM 10.05m TO 10.1m"»
  «text (36000,11960) 1 0 0 0x1000000 -1 -1 "ï»¿.meas tran s13_ib00 AVG I(V5) FROM 10.05m TO 10.1m"»
